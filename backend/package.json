{
  "name": "backend-ece",
  "version": "1.0.0",
  "description": "Backend Hexagonal para Expediente Clínico Electrónico con Cifrado FLE (AES-256-GCM)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "prisma migrate dev",
    "db:sync": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed:dev": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "tsx --test src/infrastructure/adapters/driven/security/node-crypto-encryption.adapter.test.ts src/infrastructure/appointments/clinic-time.service.test.ts src/infrastructure/notifications/notification.service.test.ts src/infrastructure/documents/prescription-document.service.test.ts src/infrastructure/storage/clinical-storage.service.test.ts",
    "test:integration": "tsx --test src/infrastructure/notifications/notification.integration.test.ts src/infrastructure/appointments/appointment.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-presigned-post": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@prisma/client": "^5.20.0",
    "@types/pdfkit": "^0.17.7",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.10",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
